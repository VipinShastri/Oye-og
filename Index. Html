</main>
<footer>© <span id="yr"></span> Vipin Shastri</footer>

<script>
const $=s=>document.querySelector(s);
const S=[
["Spreadsheets","Excel / Sheets: XLOOKUP, INDEX-MATCH, SUMIFS, Pivot Tables, Data Validation, formatting","Power Pivot, data modeling, quick ad-hoc data audits"],
["Database & SQL","SELECT, WHERE, GROUP BY, INNER / LEFT JOIN","Window functions, CTEs, subqueries, stored procedures, optimization"],
["Automation & Scripting","VBA / Excel macros for daily report automation","Python / R: automated data pipelines, ETL scripts, API integrations"],
["BI & Visualization","Power BI / Tableau: refreshing reports, card and chart updates","Complex DAX, data modeling, interactive KPI dashboards, Looker"],
["Analytics & Math","Totals, averages, MoM / YoY growth tracking","Inferential statistics, hypothesis testing, trend analysis, regression, forecasting"],
["Source Systems","ERP / CRM: SAP, Tally, Salesforce, Zoho, internal CRM","Snowflake, BigQuery, Redshift, SQL databases, APIs"],
["Primary Deliverables","DSR, WSR, MSR status reports and operations trackers","Business insight decks, root-cause analysis, churn / retention models, strategic recommendations"]
];
const P=[
{t:"Automated Sales & Operations Tracker",f:"MIS",k:["Advanced Excel","VBA / Macros"],
o:"Automate the manual reporting work behind daily sales and inventory tracking.",
d:["VBA macro that cleans and validates raw data automatically","Dynamic DSR (Daily Sales Report) tracker using XLOOKUP, SUMIFS and Pivot Tables","One-click PDF report export button for management"],
l:[["Dataset: Superstore Sales (Kaggle)","https://www.kaggle.com/datasets/vivek468/superstore-dataset-final"],["Guide: Excel VBA getting started (Microsoft)","https://learn.microsoft.com/en-us/office/vba/library-reference/concepts/getting-started-with-vba-in-office"]]},
{t:"Retail Business Performance & KPI Dashboard",f:"BI",k:["SQL","Power BI","DAX"],
o:"Visualize cross-category sales, profit margins and regional performance.",
d:["SQL queries (joins, aggregations) to extract sales, customer and product data from a relational database","DAX measures for MoM sales growth, top 10 profitable products and returns rate","Executive-level interactive dashboard with slicers for region, date range and product category"],
l:[["Database: AdventureWorks samples (Microsoft)","https://learn.microsoft.com/en-us/sql/samples/adventureworks-install-configure"],["Data: Power BI sample datasets (Microsoft)","https://learn.microsoft.com/en-us/power-bi/create-reports/sample-datasets"]]},
{t:"Customer Churn & Retention Analysis",f:"Analytics",k:["SQL / Python","Pandas","Power BI / Excel"],
o:"Identify the behavior patterns of repeat customers and customers at risk of churning.",
d:["RFM (Recency, Frequency, Monetary) analysis to divide customers into segments","Churn rate and retention trends using SQL window functions or Python (Pandas)","Recommendations deck for management: retention strategy for high-value customers to reduce churn"],
l:[["Dataset: Telco Customer Churn, IBM (Kaggle)","https://www.kaggle.com/datasets/blastchar/telco-customer-churn"]]}
];
$('#sk').innerHTML=S.map(([t,c,a])=>`<div class="card"><h3>${t}</h3><p><em>Core</em>${c}</p><p class="adv"><em>Advanced</em>${a}</p></div>`).join('');
$('#pj').innerHTML=P.map(p=>`<article class="card proj rv"><div class="hd"><h3>${p.t}</h3><span class="f">${p.f}</span></div><p class="ob">${p.o}</p><ul>${p.d.map(x=>`<li>${x}</li>`).join('')}</ul><div class="tl">${p.k.map(x=>`<span>${x}</span>`).join('')}</div><div class="links">${p.l.map(([a,b])=>`<a href="${b}" target="_blank" rel="noopener">${a}</a>`).join('')}</div></article>`).join('');
$('#yr').textContent=new Date().getFullYear();
const io=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
const fx=$('#fx');
const so=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)fx.textContent='=GOTO("'+x.target.id+'")'}),{rootMargin:'-45% 0px -50% 0px'});
document.querySelectorAll('section[id]').forEach(s=>so.observe(s));
setTimeout(()=>$('#sheet').classList.add('on'),300);
</script>
</body>
</html>
